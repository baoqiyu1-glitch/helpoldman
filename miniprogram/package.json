    },
    "dependencies": {
        "vue": "^2.6.11",
        "vuex": "^3.4.0"
    },
    "devDependencies": {
        "@dcloudio/vue-cli-plugin-uni": "^2.0.0",
        "babel-eslint": "^10.1.0",
        "cross-env": "^7.0.2",
        "eslint": "^6.8.0",
        "eslint-plugin-vue": "^6.2.2"
    },
    "author": "",
    "license": "MIT"
}
