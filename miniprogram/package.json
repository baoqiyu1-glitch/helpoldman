{
    "name": "helpoldman-miniprogram",
    "version": "1.0.0",
    "description": "助老助残系统小程序端",
    "main": "main.js",
    "scripts": {
        "dev": "npm run dev:mp-weixin",
        "dev:mp-weixin": "cross-env NODE_ENV=development UNI_PLATFORM=mp-weixin vue-cli-service uni-serve",
