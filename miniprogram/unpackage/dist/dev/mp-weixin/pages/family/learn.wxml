<view class="learn-container data-v-2dc4575c"><block wx:if="{{$root.g0>0}}"><view class="elder-selection data-v-2dc4575c"><text class="section-title data-v-2dc4575c">选择老人</text><view class="elder-list data-v-2dc4575c"><block wx:for="{{elders}}" wx:for-item="elder" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectElder',['$0'],[[['elders','id',elder.id]]]]]]]}}" class="{{['elder-item','data-v-2dc4575c',(selectedElder&&selectedElder.id===elder.id)?'active':'']}}" bindtap="__e"><text class="elder-name data-v-2dc4575c">{{elder.name}}</text><text class="elder-relation data-v-2dc4575c">{{elder.relation}}</text></view></block></view></view></block><view class="course-list data-v-2dc4575c"><block wx:for="{{courseList}}" wx:for-item="course" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['selectCourse',['$0'],[[['courseList','id',course.id]]]]]]]}}" class="course-item data-v-2dc4575c" bindtap="__e"><image class="course-image data-v-2dc4575c" src="{{course.image}}" mode="aspectFill"></image><view class="course-info data-v-2dc4575c"><text class="course-title data-v-2dc4575c">{{course.title}}</text><text class="course-desc data-v-2dc4575c">{{course.description}}</text><view class="course-meta data-v-2dc4575c"><text class="teacher data-v-2dc4575c">{{"讲师："+course.teacher}}</text><text class="duration data-v-2dc4575c">{{"时长："+course.duration}}</text></view><button data-event-opts="{{[['tap',[['applyLearning',['$0'],[[['courseList','id',course.id]]]]]]]}}" class="study-btn data-v-2dc4575c" catchtap="__e">申请学习</button></view></view></block></view></view>