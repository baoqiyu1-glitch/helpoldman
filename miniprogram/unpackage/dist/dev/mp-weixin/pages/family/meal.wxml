<view class="meal-container data-v-befbdeb6"><view class="meal-form data-v-befbdeb6"><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">送餐地址</text><input type="text" placeholder="请输入详细送餐地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['orderForm']]]]]}}" value="{{orderForm.address}}" bindinput="__e" class="data-v-befbdeb6"/></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">联系电话</text><input type="tel" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['orderForm']]]]]}}" value="{{orderForm.phone}}" bindinput="__e" class="data-v-befbdeb6"/></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">送餐时间</text><picker mode="date" value="{{orderForm.date}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]],['input',[['__set_model',['$0','date','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{'日期：'+orderForm.date+''}}</view></picker><picker mode="time" value="{{orderForm.time}}" data-event-opts="{{[['change',[['onTimeChange',['$event']]]],['input',[['__set_model',['$0','time','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{'时间：'+orderForm.time+''}}</view></picker></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">餐食类型</text><picker mode="selector" range="{{mealTypes}}" value="{{orderForm.mealTypeIndex}}" data-event-opts="{{[['change',[['onMealTypeChange',['$event']]]],['input',[['__set_model',['$0','mealTypeIndex','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{''+mealTypes[orderForm.mealTypeIndex]+''}}</view></picker></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">特殊要求</text><textarea style="height:120rpx;" placeholder="请输入特殊饮食要求（如低盐、糖尿病餐等）" data-event-opts="{{[['input',[['__set_model',['$0','requirements','$event',[]],['orderForm']]]]]}}" value="{{orderForm.requirements}}" bindinput="__e" class="data-v-befbdeb6"></textarea></view><view class="total-price data-v-befbdeb6"><text class="data-v-befbdeb6">{{"总计：¥"+totalPrice}}</text></view><button type="primary" data-event-opts="{{[['tap',[['submitOrder',['$event']]]]]}}" bindtap="__e" class="data-v-befbdeb6">提交订单</button></view></view>