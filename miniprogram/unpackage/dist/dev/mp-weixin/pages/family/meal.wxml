<view class="meal-container data-v-befbdeb6"><block wx:if="{{$root.g0>0}}"><view class="elder-selection data-v-befbdeb6"><text class="section-title data-v-befbdeb6">选择老人</text><view class="elder-list data-v-befbdeb6"><block wx:for="{{elders}}" wx:for-item="elder" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectElder',['$0'],[[['elders','id',elder.id]]]]]]]}}" class="{{['elder-item','data-v-befbdeb6',(selectedElder&&selectedElder.id===elder.id)?'active':'']}}" bindtap="__e"><text class="elder-name data-v-befbdeb6">{{elder.name}}</text><text class="elder-relation data-v-befbdeb6">{{elder.relation}}</text></view></block></view></view></block><view class="meal-form data-v-befbdeb6"><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">送餐地址</text><input type="text" placeholder="请输入详细送餐地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['orderForm']]]]]}}" value="{{orderForm.address}}" bindinput="__e" class="data-v-befbdeb6"/></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">联系电话</text><input type="tel" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['orderForm']]]]]}}" value="{{orderForm.phone}}" bindinput="__e" class="data-v-befbdeb6"/></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">送餐时间</text><picker mode="date" value="{{orderForm.serviceTime}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]],['input',[['__set_model',['$0','serviceTime','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{''+(orderForm.serviceTime||'请选择日期')+''}}</view></picker><picker mode="time" value="{{orderForm.serviceHour}}" data-event-opts="{{[['change',[['onTimeChange',['$event']]]],['input',[['__set_model',['$0','serviceHour','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{''+(orderForm.serviceHour||'请选择时间')+''}}</view></picker></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">餐食类型</text><picker mode="selector" range="{{mealTypes}}" value="{{orderForm.mealTypeIndex}}" data-event-opts="{{[['change',[['onMealTypeChange',['$event']]]],['input',[['__set_model',['$0','mealTypeIndex','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{''+mealTypes[orderForm.mealTypeIndex]+''}}</view></picker></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">送餐频率</text><picker mode="selector" range="{{frequencies}}" value="{{orderForm.frequencyIndex}}" data-event-opts="{{[['change',[['onFrequencyChange',['$event']]]],['input',[['__set_model',['$0','frequencyIndex','$event',[]],['orderForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-befbdeb6"><view class="picker data-v-befbdeb6">{{''+frequencies[orderForm.frequencyIndex]+''}}</view></picker></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">送餐天数</text><input type="number" placeholder="请输入送餐天数" data-event-opts="{{[['input',[['__set_model',['$0','duration','$event',[]],['orderForm']]]]]}}" value="{{orderForm.duration}}" bindinput="__e" class="data-v-befbdeb6"/></view><view class="form-item data-v-befbdeb6"><text class="label data-v-befbdeb6">特殊要求</text><textarea style="height:120rpx;" placeholder="请输入特殊饮食要求（如低盐、糖尿病餐等）" data-event-opts="{{[['input',[['__set_model',['$0','specialRequirements','$event',[]],['orderForm']]]]]}}" value="{{orderForm.specialRequirements}}" bindinput="__e" class="data-v-befbdeb6"></textarea></view><view class="total-price data-v-befbdeb6"><text class="data-v-befbdeb6">{{"总计：¥"+$root.m0}}</text></view><button type="primary" data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" bindtap="__e" class="data-v-befbdeb6">提交申请</button></view></view>