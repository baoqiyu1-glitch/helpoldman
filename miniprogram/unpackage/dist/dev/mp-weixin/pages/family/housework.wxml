<view class="housework-container data-v-451bca82"><block wx:if="{{$root.g0>0}}"><view class="elder-selection data-v-451bca82"><text class="section-title data-v-451bca82">选择老人</text><view class="elder-list data-v-451bca82"><block wx:for="{{elders}}" wx:for-item="elder" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectElder',['$0'],[[['elders','id',elder.id]]]]]]]}}" class="{{['elder-item','data-v-451bca82',(selectedElder&&selectedElder.id===elder.id)?'active':'']}}" bindtap="__e"><text class="elder-name data-v-451bca82">{{elder.name}}</text><text class="elder-relation data-v-451bca82">{{elder.relation}}</text></view></block></view></view></block><view class="service-list data-v-451bca82"><block wx:for="{{services}}" wx:for-item="service" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['selectService',['$0'],[[['services','id',service.id]]]]]]]}}" class="service-item data-v-451bca82" bindtap="__e"><text class="service-name data-v-451bca82">{{service.name}}</text><text class="service-price data-v-451bca82">{{service.price+"元/次"}}</text></view></block></view><block wx:if="{{selectedService}}"><view class="order-form data-v-451bca82"><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务类型</text><text class="value data-v-451bca82">{{selectedService.name}}</text></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务时间</text><picker mode="date" value="{{serviceData.serviceTime}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]],['input',[['__set_model',['$0','serviceTime','$event',[]],['serviceData']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-451bca82"><view class="picker data-v-451bca82">{{''+(serviceData.serviceTime||'请选择服务日期')+''}}</view></picker></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务时长（小时）</text><input type="number" placeholder="请输入服务时长" data-event-opts="{{[['input',[['__set_model',['$0','duration','$event',[]],['serviceData']]]]]}}" value="{{serviceData.duration}}" bindinput="__e" class="data-v-451bca82"/></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务地址</text><input type="text" placeholder="请输入服务地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['serviceData']]]]]}}" value="{{serviceData.address}}" bindinput="__e" class="data-v-451bca82"/></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">联系电话</text><input type="tel" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['serviceData']]]]]}}" value="{{serviceData.phone}}" bindinput="__e" class="data-v-451bca82"/></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">特殊要求</text><textarea style="height:120rpx;" placeholder="请输入特殊要求（可选）" data-event-opts="{{[['input',[['__set_model',['$0','specialRequirements','$event',[]],['serviceData']]]]]}}" value="{{serviceData.specialRequirements}}" bindinput="__e" class="data-v-451bca82"></textarea></view><view class="total-price data-v-451bca82"><text class="data-v-451bca82">{{"总计：¥"+selectedService.price*(serviceData.duration||1)}}</text></view><button type="primary" data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" bindtap="__e" class="data-v-451bca82">提交申请</button></view></block></view>