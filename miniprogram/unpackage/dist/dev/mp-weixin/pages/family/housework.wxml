<view class="housework-container data-v-451bca82"><view class="service-list data-v-451bca82"><block wx:for="{{services}}" wx:for-item="service" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectService',['$0'],[[['services','id',service.id]]]]]]]}}" class="service-item data-v-451bca82" bindtap="__e"><text class="service-name data-v-451bca82">{{service.name}}</text><text class="service-price data-v-451bca82">{{service.price+"元/次"}}</text></view></block></view><block wx:if="{{selectedService}}"><view class="order-form data-v-451bca82"><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务类型</text><text class="value data-v-451bca82">{{selectedService.name}}</text></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务时间</text><picker mode="date" value="{{order.date}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]],['input',[['__set_model',['$0','date','$event',[]],['order']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-451bca82"><view class="picker data-v-451bca82">{{''+order.date+''}}</view></picker></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">服务地址</text><input type="text" placeholder="请输入服务地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['order']]]]]}}" value="{{order.address}}" bindinput="__e" class="data-v-451bca82"/></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">联系电话</text><input type="tel" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['order']]]]]}}" value="{{order.phone}}" bindinput="__e" class="data-v-451bca82"/></view><view class="form-item data-v-451bca82"><text class="label data-v-451bca82">备注</text><textarea style="height:150rpx;" placeholder="请输入服务需求备注" data-event-opts="{{[['input',[['__set_model',['$0','remark','$event',[]],['order']]]]]}}" value="{{order.remark}}" bindinput="__e" class="data-v-451bca82"></textarea></view><view class="total-price data-v-451bca82"><text class="data-v-451bca82">{{"总计：¥"+selectedService.price}}</text></view><button type="primary" data-event-opts="{{[['tap',[['submitOrder',['$event']]]]]}}" bindtap="__e" class="data-v-451bca82">提交订单</button></view></block></view>