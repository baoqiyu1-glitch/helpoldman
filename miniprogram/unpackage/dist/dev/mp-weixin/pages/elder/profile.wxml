<view class="profile-container data-v-73faae0a"><view class="profile-header data-v-73faae0a"><image class="avatar data-v-73faae0a" src="{{userInfo.avatarUrl||'../../static/images/avatar.png'}}" mode="aspectFill"></image><view class="user-info data-v-73faae0a"><text class="username data-v-73faae0a">{{userInfo.realName||userInfo.username}}</text><text class="user-type data-v-73faae0a">老人用户</text></view></view><view class="profile-content data-v-73faae0a"><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">姓名</text><text class="value data-v-73faae0a">{{userInfo.realName||userInfo.username}}</text></view><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">年龄</text><text class="value data-v-73faae0a">{{userInfo.age?userInfo.age+'岁':''}}</text></view><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">性别</text><text class="value data-v-73faae0a">{{userInfo.gender}}</text></view><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">联系电话</text><text class="value data-v-73faae0a">{{userInfo.phone}}</text></view><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">家庭地址</text><text class="value data-v-73faae0a">{{userInfo.address}}</text></view><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">紧急联系人</text><text class="value data-v-73faae0a">{{userInfo.emergencyContact}}</text></view><view class="info-item data-v-73faae0a"><text class="label data-v-73faae0a">紧急联系电话</text><text class="value data-v-73faae0a">{{userInfo.emergencyPhone}}</text></view></view><view class="action-btn data-v-73faae0a"><button type="primary" data-event-opts="{{[['tap',[['editProfile',['$event']]]]]}}" bindtap="__e" class="data-v-73faae0a">编辑档案</button></view></view>