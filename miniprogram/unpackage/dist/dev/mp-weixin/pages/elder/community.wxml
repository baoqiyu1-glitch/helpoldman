<view class="community-container data-v-a2f26e8a"><block wx:if="{{showPublishForm}}"><view class="publish-form data-v-a2f26e8a"><view class="form-item data-v-a2f26e8a"><text class="label data-v-a2f26e8a">互助类型</text><picker value="{{typeIndex}}" range="{{typeOptions}}" data-event-opts="{{[['change',[['onTypeChange',['$event']]]]]}}" bindchange="__e" class="data-v-a2f26e8a"><view class="picker data-v-a2f26e8a">{{typeOptions[typeIndex]||'请选择互助类型'}}</view></picker></view><view class="form-item data-v-a2f26e8a"><text class="label data-v-a2f26e8a">标题</text><input type="text" placeholder="请输入互助标题" data-event-opts="{{[['input',[['__set_model',['$0','title','$event',[]],['publishData']]]]]}}" value="{{publishData.title}}" bindinput="__e" class="data-v-a2f26e8a"/></view><view class="form-item data-v-a2f26e8a"><text class="label data-v-a2f26e8a">详细描述</text><textarea style="height:120rpx;" placeholder="请详细描述需要帮助的内容" data-event-opts="{{[['input',[['__set_model',['$0','content','$event',[]],['publishData']]]]]}}" value="{{publishData.content}}" bindinput="__e" class="data-v-a2f26e8a"></textarea></view><view class="form-item data-v-a2f26e8a"><text class="label data-v-a2f26e8a">期望帮助时间</text><picker mode="date" value="{{publishData.expectedTime}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]]]}}" bindchange="__e" class="data-v-a2f26e8a"><view class="picker data-v-a2f26e8a">{{publishData.expectedTime||'请选择期望时间'}}</view></picker></view><view class="form-item data-v-a2f26e8a"><text class="label data-v-a2f26e8a">联系方式</text><input type="text" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','contact','$event',[]],['publishData']]]]]}}" value="{{publishData.contact}}" bindinput="__e" class="data-v-a2f26e8a"/></view><view class="form-actions data-v-a2f26e8a"><button data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="btn-cancel data-v-a2f26e8a" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['publishHelp',['$event']]]]]}}" class="btn-submit data-v-a2f26e8a" bindtap="__e">发布</button></view></view></block><block wx:else><view class="help-list data-v-a2f26e8a"><view class="section-header data-v-a2f26e8a"><text class="title data-v-a2f26e8a">社区互助</text><button data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="btn-new data-v-a2f26e8a" bindtap="__e">+ 发布求助</button></view><view class="help-items data-v-a2f26e8a"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="help-item data-v-a2f26e8a"><view class="help-header data-v-a2f26e8a"><text class="type data-v-a2f26e8a">{{item.m0}}</text><text class="{{['status','data-v-a2f26e8a',item.$orig.statusClass]}}">{{item.m1}}</text></view><text class="title data-v-a2f26e8a">{{item.$orig.title}}</text><text class="content data-v-a2f26e8a">{{item.$orig.content}}</text><view class="help-footer data-v-a2f26e8a"><text class="author data-v-a2f26e8a">{{item.$orig.createBy}}</text><text class="time data-v-a2f26e8a">{{item.m2}}</text><block wx:if="{{item.$orig.status==='PENDING'}}"><button data-event-opts="{{[['tap',[['respondHelp',['$0'],[[['helpList','id',item.$orig.id,'id']]]]]]]}}" class="btn-respond data-v-a2f26e8a" bindtap="__e">响应帮助</button></block></view></view></block><block wx:if="{{hasMore}}"><view data-event-opts="{{[['tap',[['loadMore',['$event']]]]]}}" class="load-more data-v-a2f26e8a" bindtap="__e"><text class="data-v-a2f26e8a">加载更多</text></view></block><block wx:if="{{$root.g0===0}}"><view class="empty data-v-a2f26e8a"><text class="data-v-a2f26e8a">暂无互助信息</text></view></block></view></view></block></view>