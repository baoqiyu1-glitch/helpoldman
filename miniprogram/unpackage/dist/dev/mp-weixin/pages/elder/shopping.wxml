<view class="shopping-container data-v-55f86e06"><view class="search-bar data-v-55f86e06"><input type="text" placeholder="搜索需要代购的商品" data-event-opts="{{[['input',[['__set_model',['','searchText','$event',[]]]]]]}}" value="{{searchText}}" bindinput="__e" class="data-v-55f86e06"/><button data-event-opts="{{[['tap',[['search',['$event']]]]]}}" bindtap="__e" class="data-v-55f86e06">搜索</button></view><view class="category-list data-v-55f86e06"><block wx:for="{{categories}}" wx:for-item="category" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectCategory',['$0'],[[['categories','id',category.id]]]]]]]}}" class="category-item data-v-55f86e06" bindtap="__e"><text class="data-v-55f86e06">{{category.name}}</text></view></block></view><view class="product-list data-v-55f86e06"><block wx:for="{{products}}" wx:for-item="product" wx:for-index="__i1__" wx:key="id"><view class="product-item data-v-55f86e06"><image class="product-image data-v-55f86e06" src="{{product.image}}" mode="aspectFill"></image><view class="product-info data-v-55f86e06"><text class="product-name data-v-55f86e06">{{product.name}}</text><text class="product-price data-v-55f86e06">{{"¥"+product.price}}</text><button data-event-opts="{{[['tap',[['addProduct',['$0'],[[['products','id',product.id]]]]]]]}}" class="add-btn data-v-55f86e06" bindtap="__e">加入购物车</button></view></view></block></view><block wx:if="{{cartCount>0}}"><view class="cart-bar data-v-55f86e06"><text class="cart-count data-v-55f86e06">{{cartCount}}</text><button type="primary" data-event-opts="{{[['tap',[['goToCart',['$event']]]]]}}" bindtap="__e" class="data-v-55f86e06">去结算</button></view></block></view>