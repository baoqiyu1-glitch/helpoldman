<view class="shopping-container data-v-55f86e06"><view class="demand-section data-v-55f86e06"><view class="section-title data-v-55f86e06"><text class="data-v-55f86e06">发布代购需求</text></view><view class="demand-form data-v-55f86e06"><view class="form-item data-v-55f86e06"><text class="label data-v-55f86e06">代购物品</text><textarea style="height:120rpx;" placeholder="请详细描述需要代购的物品清单" data-event-opts="{{[['input',[['__set_model',['$0','serviceContent','$event',[]],['demandForm']]]]]}}" value="{{demandForm.serviceContent}}" bindinput="__e" class="data-v-55f86e06"></textarea></view><view class="form-item data-v-55f86e06"><text class="label data-v-55f86e06">期望送达时间</text><picker mode="date" value="{{demandForm.appointmentTime}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]]]}}" bindchange="__e" class="data-v-55f86e06"><view class="picker data-v-55f86e06">{{demandForm.appointmentTime||'请选择日期'}}</view></picker></view><view class="form-item data-v-55f86e06"><text class="label data-v-55f86e06">送达地址</text><input type="text" placeholder="请输入详细地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['demandForm']]]]]}}" value="{{demandForm.address}}" bindinput="__e" class="data-v-55f86e06"/></view><view class="form-item data-v-55f86e06"><text class="label data-v-55f86e06">联系电话</text><input type="text" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','contactPhone','$event',[]],['demandForm']]]]]}}" value="{{demandForm.contactPhone}}" bindinput="__e" class="data-v-55f86e06"/></view><view class="form-item data-v-55f86e06"><text class="label data-v-55f86e06">备注信息</text><textarea style="height:80rpx;" placeholder="请输入特殊要求或备注" data-event-opts="{{[['input',[['__set_model',['$0','remarks','$event',[]],['demandForm']]]]]}}" value="{{demandForm.remarks}}" bindinput="__e" class="data-v-55f86e06"></textarea></view><button type="primary" data-event-opts="{{[['tap',[['submitDemand',['$event']]]]]}}" bindtap="__e" class="data-v-55f86e06">发布代购需求</button></view></view><view class="browse-section data-v-55f86e06"><view class="section-title data-v-55f86e06"><text class="data-v-55f86e06">商品浏览</text></view><view class="search-bar data-v-55f86e06"><input type="text" placeholder="搜索需要代购的商品" data-event-opts="{{[['input',[['__set_model',['','searchText','$event',[]]]]]]}}" value="{{searchText}}" bindinput="__e" class="data-v-55f86e06"/><button data-event-opts="{{[['tap',[['search',['$event']]]]]}}" bindtap="__e" class="data-v-55f86e06">搜索</button></view><view class="category-list data-v-55f86e06"><block wx:for="{{categories}}" wx:for-item="category" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectCategory',['$0'],[[['categories','id',category.id]]]]]]]}}" class="category-item data-v-55f86e06" bindtap="__e"><text class="data-v-55f86e06">{{category.name}}</text></view></block></view><view class="product-list data-v-55f86e06"><block wx:for="{{products}}" wx:for-item="product" wx:for-index="__i1__" wx:key="id"><view class="product-item data-v-55f86e06"><image class="product-image data-v-55f86e06" src="{{product.image}}" mode="aspectFill"></image><view class="product-info data-v-55f86e06"><text class="product-name data-v-55f86e06">{{product.name}}</text><text class="product-price data-v-55f86e06">{{"¥"+product.price}}</text><button data-event-opts="{{[['tap',[['addProduct',['$0'],[[['products','id',product.id]]]]]]]}}" class="add-btn data-v-55f86e06" bindtap="__e">加入购物车</button></view></view></block></view></view></view>