
.shopping-container.data-v-55f86e06 {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 代购需求区域样式 */
.demand-section.data-v-55f86e06 {
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.section-title.data-v-55f86e06 {
  padding: 20rpx;
  background-color: #f8f8f8;
  border-bottom: 1rpx solid #eee;
  font-size: 32rpx;
  font-weight: bold;
}
.demand-form.data-v-55f86e06 {
  padding: 20rpx;
}
.form-item.data-v-55f86e06 {
  margin-bottom: 30rpx;
}
.label.data-v-55f86e06 {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  color: #333;
}
.demand-form input.data-v-55f86e06,
.demand-form textarea.data-v-55f86e06 {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #fafafa;
}
.picker.data-v-55f86e06 {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #fafafa;
}
.demand-form button.data-v-55f86e06 {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  background-color: #007AFF;
  color: #fff;
  border-radius: 10rpx;
}

/* 商品浏览区域样式 */
.browse-section.data-v-55f86e06 {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
}
.search-bar.data-v-55f86e06 {
  display: flex;
  margin-bottom: 20rpx;
}
.search-bar input.data-v-55f86e06 {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx 0 0 10rpx;
  padding: 0 20rpx;
  background-color: #fff;
}
.search-bar button.data-v-55f86e06 {
  width: 150rpx;
  height: 80rpx;
  border-radius: 0 10rpx 10rpx 0;
  background-color: #007AFF;
  color: #fff;
}
.category-list.data-v-55f86e06 {
  display: flex;
  overflow-x: scroll;
  margin-bottom: 20rpx;
  background-color: #fff;
  padding: 20rpx 0;
  border-radius: 10rpx;
}
.category-item.data-v-55f86e06 {
  padding: 20rpx 30rpx;
  margin: 0 10rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  white-space: nowrap;
}
.product-list.data-v-55f86e06 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-item.data-v-55f86e06 {
  width: 48%;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.product-image.data-v-55f86e06 {
  width: 100%;
  height: 200rpx;
}
.product-info.data-v-55f86e06 {
  padding: 20rpx;
}
.product-name.data-v-55f86e06 {
  display: block;
  font-size: 32rpx;
  margin-bottom: 10rpx;
  height: 70rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.product-price.data-v-55f86e06 {
  display: block;
  font-size: 36rpx;
  color: #FF4444;
  margin-bottom: 20rpx;
}
.add-btn.data-v-55f86e06 {
  width: 100%;
  height: 60rpx;
  font-size: 28rpx;
  background-color: #007AFF;
  color: #fff;
}

