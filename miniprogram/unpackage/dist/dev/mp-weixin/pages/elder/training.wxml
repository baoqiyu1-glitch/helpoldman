<view class="training-container data-v-16190710"><view class="training-list data-v-16190710"><block wx:for="{{trainingList}}" wx:for-item="training" wx:for-index="__i0__" wx:key="id"><view class="training-item data-v-16190710"><image class="training-image data-v-16190710" src="{{training.image}}" mode="aspectFill"></image><view class="training-info data-v-16190710"><text class="training-title data-v-16190710">{{training.name}}</text><text class="training-desc data-v-16190710">{{training.description}}</text><view class="training-meta data-v-16190710"><text class="time data-v-16190710">{{"时长: "+training.duration+"小时"}}</text><text class="price data-v-16190710">{{"费用: "+training.price+"元"}}</text></view><button data-event-opts="{{[['tap',[['applyTraining',['$0'],[[['trainingList','id',training.id]]]]]]]}}" class="apply-btn data-v-16190710" bindtap="__e">立即报名</button></view></view></block></view><block wx:if="{{selectedTraining}}"><view class="apply-form data-v-16190710"><view class="form-item data-v-16190710"><text class="label data-v-16190710">培训课程</text><text class="value data-v-16190710">{{selectedTraining.name}}</text></view><view class="form-item data-v-16190710"><text class="label data-v-16190710">报名人数</text><input type="number" placeholder="请输入报名人数" data-event-opts="{{[['input',[['__set_model',['$0','participantCount','$event',[]],['applyForm']]]]]}}" value="{{applyForm.participantCount}}" bindinput="__e" class="data-v-16190710"/></view><view class="form-item data-v-16190710"><text class="label data-v-16190710">联系方式</text><input type="tel" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','contactPhone','$event',[]],['applyForm']]]]]}}" value="{{applyForm.contactPhone}}" bindinput="__e" class="data-v-16190710"/></view><view class="form-item data-v-16190710"><text class="label data-v-16190710">联系地址</text><input type="text" placeholder="请输入详细地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['applyForm']]]]]}}" value="{{applyForm.address}}" bindinput="__e" class="data-v-16190710"/></view><view class="form-item data-v-16190710"><text class="label data-v-16190710">预约时间</text><picker mode="date" value="{{applyForm.appointmentTime}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]],['input',[['__set_model',['$0','appointmentTime','$event',[]],['applyForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-16190710"><view class="picker data-v-16190710">{{''+applyForm.appointmentTime+''}}</view></picker></view><view class="form-item data-v-16190710"><text class="label data-v-16190710">备注信息</text><textarea style="height:150rpx;" placeholder="请输入其他需求或备注" data-event-opts="{{[['input',[['__set_model',['$0','serviceContent','$event',[]],['applyForm']]]]]}}" value="{{applyForm.serviceContent}}" bindinput="__e" class="data-v-16190710"></textarea></view><view class="total-price data-v-16190710"><text class="data-v-16190710">{{"总计：¥"+selectedTraining.price*(applyForm.participantCount||1)}}</text></view><button type="primary" data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" bindtap="__e" class="data-v-16190710">提交报名</button></view></block></view>