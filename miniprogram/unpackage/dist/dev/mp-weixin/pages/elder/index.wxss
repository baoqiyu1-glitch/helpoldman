
.elder-index.data-v-2be69224 {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 用户信息区域 */
.user-info.data-v-2be69224 {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  color: white;
}
.avatar-section.data-v-2be69224 {
  display: flex;
  align-items: center;
}
.avatar.data-v-2be69224 {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 30rpx;
}
.user-details.data-v-2be69224 {
  flex: 1;
}
.username.data-v-2be69224 {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.welcome.data-v-2be69224 {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 服务功能网格 */
.service-grid.data-v-2be69224 {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.section-title.data-v-2be69224 {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}
.grid-container.data-v-2be69224 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.service-item.data-v-2be69224 {
  background-color: #f8f9fa;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s ease;
}
.service-item.data-v-2be69224:active {
  background-color: #e9ecef;
  -webkit-transform: scale(0.98);
          transform: scale(0.98);
}
.service-item.emergency.data-v-2be69224 {
  background-color: #fff5f5;
  border: 2rpx solid #ff4444;
}
.service-icon.data-v-2be69224 {
  font-size: 60rpx;
  margin-bottom: 15rpx;
  display: block;
}
.service-name.data-v-2be69224 {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.service-desc.data-v-2be69224 {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 快速操作 */
.quick-actions.data-v-2be69224 {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.action-buttons.data-v-2be69224 {
  display: flex;
  gap: 20rpx;
}
.action-btn.data-v-2be69224 {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  background-color: #f8f9fa;
  color: #333;
}
.action-btn.primary.data-v-2be69224 {
  background-color: #007AFF;
  color: white;
}

/* 通知公告 */
.notifications.data-v-2be69224 {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}
.notification-item.data-v-2be69224 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.notification-item.data-v-2be69224:last-child {
  border-bottom: none;
}
.notification-title.data-v-2be69224 {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.notification-time.data-v-2be69224 {
  font-size: 24rpx;
  color: #999;
}

