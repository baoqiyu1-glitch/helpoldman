<view class="barrier-free-container data-v-35fe1b60"><view class="intro-section data-v-35fe1b60"><text class="title data-v-35fe1b60">无障碍改造服务</text><text class="desc data-v-35fe1b60">为行动不便的老人提供居家无障碍改造服务，包括坡道安装、扶手加装、卫生间改造等。</text></view><view class="apply-form data-v-35fe1b60"><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">改造类型</text><picker mode="selector" range="{{transformTypes}}" value="{{applyForm.typeIndex}}" data-event-opts="{{[['change',[['onTypeChange',['$event']]]],['input',[['__set_model',['$0','typeIndex','$event',[]],['applyForm']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-35fe1b60"><view class="picker data-v-35fe1b60">{{''+transformTypes[applyForm.typeIndex]+''}}</view></picker></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">改造地址</text><input type="text" placeholder="请输入详细地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['applyForm']]]]]}}" value="{{applyForm.address}}" bindinput="__e" class="data-v-35fe1b60"/></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">联系电话</text><input type="tel" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['applyForm']]]]]}}" value="{{applyForm.phone}}" bindinput="__e" class="data-v-35fe1b60"/></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">改造需求描述</text><textarea style="height:200rpx;" placeholder="请详细描述您的改造需求" data-event-opts="{{[['input',[['__set_model',['$0','description','$event',[]],['applyForm']]]]]}}" value="{{applyForm.description}}" bindinput="__e" class="data-v-35fe1b60"></textarea></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">上传现场照片</text><view class="upload-section data-v-35fe1b60"><block wx:for="{{applyForm.images}}" wx:for-item="image" wx:for-index="index" wx:key="index"><view class="upload-item data-v-35fe1b60"><image src="{{image}}" mode="aspectFill" class="data-v-35fe1b60"></image><view data-event-opts="{{[['tap',[['deleteImage',[index]]]]]}}" class="delete-btn data-v-35fe1b60" bindtap="__e">×</view></view></block><block wx:if="{{$root.g0<3}}"><view data-event-opts="{{[['tap',[['uploadImage',['$event']]]]]}}" class="upload-btn data-v-35fe1b60" bindtap="__e"><text class="data-v-35fe1b60">+</text></view></block></view></view><button type="primary" data-event-opts="{{[['tap',[['submitApply',['$event']]]]]}}" bindtap="__e" class="data-v-35fe1b60">提交申请</button></view></view>