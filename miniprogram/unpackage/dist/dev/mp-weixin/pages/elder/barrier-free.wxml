<view class="barrier-free-container data-v-35fe1b60"><block wx:if="{{showForm}}"><view class="apply-form data-v-35fe1b60"><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">改造类型</text><picker value="{{typeIndex}}" range="{{typeOptions}}" data-event-opts="{{[['change',[['onTypeChange',['$event']]]]]}}" bindchange="__e" class="data-v-35fe1b60"><view class="picker data-v-35fe1b60">{{typeOptions[typeIndex]||'请选择改造类型'}}</view></picker></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">详细描述</text><textarea style="height:150rpx;" placeholder="请详细描述需要改造的内容和需求" data-event-opts="{{[['input',[['__set_model',['$0','description','$event',[]],['applyData']]]]]}}" value="{{applyData.description}}" bindinput="__e" class="data-v-35fe1b60"></textarea></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">期望改造时间</text><picker mode="date" value="{{applyData.expectedTime}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]]]}}" bindchange="__e" class="data-v-35fe1b60"><view class="picker data-v-35fe1b60">{{applyData.expectedTime||'请选择期望时间'}}</view></picker></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">预算金额（元）</text><input type="number" placeholder="请输入预算金额" data-event-opts="{{[['input',[['__set_model',['$0','budget','$event',[]],['applyData']]]]]}}" value="{{applyData.budget}}" bindinput="__e" class="data-v-35fe1b60"/></view><view class="form-item data-v-35fe1b60"><text class="label data-v-35fe1b60">地址信息</text><input type="text" placeholder="请输入详细地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['applyData']]]]]}}" value="{{applyData.address}}" bindinput="__e" class="data-v-35fe1b60"/></view><view class="form-actions data-v-35fe1b60"><button data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="btn-cancel data-v-35fe1b60" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" class="btn-submit data-v-35fe1b60" bindtap="__e">提交申请</button></view></view></block><block wx:else><view class="my-applications data-v-35fe1b60"><view class="section-header data-v-35fe1b60"><text class="title data-v-35fe1b60">我的无障碍改造申请</text><button data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="btn-new data-v-35fe1b60" bindtap="__e">+ 新申请</button></view><view class="application-list data-v-35fe1b60"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="application-item data-v-35fe1b60"><view class="application-header data-v-35fe1b60"><text class="{{['status','data-v-35fe1b60',item.$orig.statusClass]}}">{{item.m0}}</text><text class="date data-v-35fe1b60">{{item.m1}}</text></view><text class="type data-v-35fe1b60">{{"改造类型："+item.m2}}</text><text class="description data-v-35fe1b60">{{item.$orig.description}}</text><text class="budget data-v-35fe1b60">{{"预算："+item.$orig.budget+"元"}}</text><text class="address data-v-35fe1b60">{{"地址："+item.$orig.address}}</text></view></block><block wx:if="{{hasMore}}"><view data-event-opts="{{[['tap',[['loadMore',['$event']]]]]}}" class="load-more data-v-35fe1b60" bindtap="__e"><text class="data-v-35fe1b60">加载更多</text></view></block><block wx:if="{{$root.g0===0}}"><view class="empty data-v-35fe1b60"><text class="data-v-35fe1b60">暂无申请记录</text></view></block></view></view></block></view>