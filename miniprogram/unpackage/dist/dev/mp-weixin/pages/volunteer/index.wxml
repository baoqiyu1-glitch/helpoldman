<view class="volunteer-container"><block wx:if="{{loading}}"><view class="loading-container"><view class="loading-spinner"></view><text class="loading-text">加载中...</text></view></block><block wx:else><block wx:if="{{error}}"><view class="error-container"><image class="error-icon" src="/static/icons/error.png" mode="aspectFit"></image><text class="error-text">加载失败，请检查网络连接</text><button data-event-opts="{{[['tap',[['retryLoad',['$event']]]]]}}" class="retry-button" bindtap="__e">重试</button></view></block><block wx:else><view><view class="user-info-section"><view class="user-avatar"><image src="{{dashboardData.userInfo.avatar||'/static/images/avatar-default.png'}}" mode="aspectFill"></image></view><view class="user-details"><text class="username">{{dashboardData.userInfo.username||'志愿者'}}</text><text class="user-role">{{textConfig.roleText||'志愿者'}}</text></view></view><view class="stats-section"><view class="stat-item"><text class="stat-value">{{dashboardData.stats.totalHours||0}}</text><text class="stat-label">{{textConfig.serviceHoursText||'服务时长'}}</text></view><view class="stat-item"><text class="stat-value">{{dashboardData.stats.completedTasks||0}}</text><text class="stat-label">{{textConfig.completedTasksText||'完成任务'}}</text></view><view class="stat-item"><text class="stat-value">{{dashboardData.stats.currentTasks||0}}</text><text class="stat-label">{{textConfig.currentTasksText||'进行中'}}</text></view><view class="stat-item"><text class="stat-value">{{dashboardData.stats.rating||0}}</text><text class="stat-label">{{textConfig.ratingText||'评分'}}</text></view></view><view class="quick-services-section"><text class="section-title">{{textConfig.quickServicesText||'快速服务'}}</text><view class="services-grid"><view data-event-opts="{{[['tap',[['navigateToService',['shopping']]]]]}}" class="service-item" bindtap="__e"><image class="service-icon" src="/static/images/shopping.png" mode="aspectFit"></image><text class="service-name">代购物资</text></view><view data-event-opts="{{[['tap',[['navigateToService',['housework']]]]]}}" class="service-item" bindtap="__e"><image class="service-icon" src="/static/images/housework.png" mode="aspectFit"></image><text class="service-name">协助家务</text></view><view data-event-opts="{{[['tap',[['navigateToService',['my-tasks']]]]]}}" class="service-item" bindtap="__e"><image class="service-icon" src="/static/images/tasks.png" mode="aspectFit"></image><text class="service-name">我的任务</text></view><view data-event-opts="{{[['tap',[['navigateToService',['training']]]]]}}" class="service-item" bindtap="__e"><image class="service-icon" src="/static/images/training.png" mode="aspectFit"></image><text class="service-name">培训技能</text></view></view></view><view class="training-courses-section"><view class="section-header"><text class="section-title">{{textConfig.trainingTexts&&textConfig.trainingTexts.courseList||'培训课程'}}</text><text data-event-opts="{{[['tap',[['navigateToTraining',['$event']]]]]}}" class="view-all" bindtap="__e">查看全部</text></view><view class="courses-list"><block wx:if="{{$root.g0}}"><view><block wx:for="{{$root.l0}}" wx:for-item="course" wx:for-index="__i0__" wx:key="id"><view class="course-item"><view class="course-info"><text class="course-title">{{course.title}}</text><view class="course-details"><text class="course-instructor">{{''+(textConfig.trainingTexts&&textConfig.trainingTexts.instructor||'讲师')+": "+course.instructor+''}}</text><text class="course-duration">{{''+(textConfig.trainingTexts&&textConfig.trainingTexts.duration||'时长')+": "+course.duration+''}}</text></view><view class="course-stats"><text class="registered-count">{{''+(textConfig.trainingTexts&&textConfig.trainingTexts.registeredCount||'已报名')+": "+(course.registeredCount||0)+''}}</text><text class="course-capacity">{{''+(textConfig.trainingTexts&&textConfig.trainingTexts.capacity||'容量')+": "+(course.capacity||0)+''}}</text></view></view><button data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({course})}}" class="register-btn" bindtap="__e">{{''+(textConfig.trainingTexts&&textConfig.trainingTexts.registerBtn||'报名')+''}}</button></view></block></view></block><block wx:else><view class="no-courses"><text>{{textConfig.trainingTexts&&textConfig.trainingTexts.noCourses||'暂无培训课程'}}</text></view></block></view></view><view class="recent-tasks-section"><text class="section-title">{{textConfig.recentTasksText||'最近任务'}}</text><view class="tasks-list"><block wx:for="{{dashboardData.tasks}}" wx:for-item="task" wx:for-index="__i1__" wx:key="id"><view class="task-item"><view class="task-info"><text class="task-title">{{task.title}}</text><text class="task-type">{{textConfig.serviceTexts&&textConfig.serviceTexts[task.type]||task.type}}</text><text class="task-date">{{task.date}}</text></view><view class="{{['task-status',(task.status==='pending')?'status-pending':'',(task.status==='in_progress')?'status-in-progress':'',(task.status==='completed')?'status-completed':'']}}">{{''+(textConfig.taskStatusTexts&&textConfig.taskStatusTexts[task.status]||task.status)+''}}</view></view></block></view></view><view class="custom-tabbar"><view data-event-opts="{{[['tap',[['switchTab',['index']]]]]}}" class="{{['tab-item',(currentTab==='index')?'active':'']}}" bindtap="__e"><image class="tab-icon" src="/static/icons/home.png" mode="aspectFit"></image><text class="tab-text">首页</text></view><view data-event-opts="{{[['tap',[['switchTab',['services']]]]]}}" class="{{['tab-item',(currentTab==='services')?'active':'']}}" bindtap="__e"><image class="tab-icon" src="/static/icons/services.png" mode="aspectFit"></image><text class="tab-text">服务</text></view><view data-event-opts="{{[['tap',[['switchTab',['messages']]]]]}}" class="{{['tab-item',(currentTab==='messages')?'active':'']}}" bindtap="__e"><image class="tab-icon" src="/static/icons/messages.png" mode="aspectFit"></image><text class="tab-text">消息</text></view><view data-event-opts="{{[['tap',[['switchTab',['profile']]]]]}}" class="{{['tab-item',(currentTab==='profile')?'active':'']}}" bindtap="__e"><image class="tab-icon" src="/static/icons/profile.png" mode="aspectFit"></image><text class="tab-text">我的</text></view></view></view></block></block></view>