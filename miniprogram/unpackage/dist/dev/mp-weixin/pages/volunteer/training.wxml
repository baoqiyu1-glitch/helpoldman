<view class="training-container data-v-e8ea4b10"><block wx:if="{{loading}}"><view class="loading data-v-e8ea4b10">加载中...</view></block><block wx:if="{{error}}"><view class="error data-v-e8ea4b10">{{error}}</view></block><block wx:if="{{!loading&&!error}}"><view class="page-header data-v-e8ea4b10"><text class="title data-v-e8ea4b10">{{textConfig.trainingTexts&&textConfig.trainingTexts.pageTitle||'培训学习'}}</text></view></block><block wx:if="{{!loading&&!error}}"><view class="training-list data-v-e8ea4b10"><block wx:if="{{$root.g0===0}}"><view class="no-courses data-v-e8ea4b10"><text class="data-v-e8ea4b10">{{textConfig.trainingTexts&&textConfig.trainingTexts.noCourses||'暂无培训课程'}}</text></view></block><block wx:for="{{$root.l0}}" wx:for-item="course" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['viewCourseDetails',['$0'],[[['trainingCourses','id',course.$orig.id]]]]]]]}}" class="training-item data-v-e8ea4b10" bindtap="__e"><view class="course-header data-v-e8ea4b10"><text class="course-title data-v-e8ea4b10">{{course.$orig.title}}</text><text class="{{['course-status','data-v-e8ea4b10',(course.m0==='ongoing')?'ongoing':'',(course.m1==='upcoming')?'upcoming':'',(course.m2==='completed')?'completed':'']}}">{{''+course.m3+''}}</text></view><view class="course-info data-v-e8ea4b10"><text class="course-desc data-v-e8ea4b10">{{course.$orig.description}}</text></view><view class="course-meta data-v-e8ea4b10"><text class="time data-v-e8ea4b10">{{(textConfig.trainingTexts&&textConfig.trainingTexts.time||'时间')+"："+course.$orig.time}}</text><text class="location data-v-e8ea4b10">{{(textConfig.trainingTexts&&textConfig.trainingTexts.location||'地点')+"："+course.$orig.location}}</text></view><view class="course-details data-v-e8ea4b10"><text class="instructor data-v-e8ea4b10">{{(textConfig.trainingTexts&&textConfig.trainingTexts.instructor||'讲师')+"："+course.$orig.instructor}}</text><text class="duration data-v-e8ea4b10">{{(textConfig.trainingTexts&&textConfig.trainingTexts.duration||'时长')+"："+course.$orig.duration+"分钟"}}</text></view><view class="course-capacity data-v-e8ea4b10"><text class="capacity data-v-e8ea4b10">{{(textConfig.trainingTexts&&textConfig.trainingTexts.capacity||'容量')+"："+course.$orig.capacity+"人"}}</text><text class="registered data-v-e8ea4b10">{{(textConfig.trainingTexts&&textConfig.trainingTexts.registeredCount||'已报名')+"："+(course.$orig.registeredCount||0)+"人"}}</text></view><view class="course-actions data-v-e8ea4b10"><block wx:if="{{course.m4==='ongoing'}}"><button data-event-opts="{{[['tap',[['registerCourse',['$0'],[[['trainingCourses','id',course.$orig.id]]]]]]]}}" class="register-btn data-v-e8ea4b10" catchtap="__e">{{''+(textConfig.trainingTexts&&textConfig.trainingTexts.registerBtn||'报名')+''}}</button></block><block wx:else><text class="{{['status-text','data-v-e8ea4b10',(course.m5==='ongoing')?'ongoing':'',(course.m6==='upcoming')?'upcoming':'',(course.m7==='completed')?'completed':'']}}">{{''+course.m8+''}}</text></block></view></view></block></view></block></view>