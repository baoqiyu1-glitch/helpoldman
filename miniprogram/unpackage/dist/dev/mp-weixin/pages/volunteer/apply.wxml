<view class="apply-container data-v-abb4be80"><block wx:if="{{loading}}"><view class="loading data-v-abb4be80">加载中...</view></block><block wx:if="{{error}}"><view class="error data-v-abb4be80">{{error}}</view></block><block wx:if="{{!loading&&!error}}"><view class="page-header data-v-abb4be80"><text class="title data-v-abb4be80">{{textConfig.pageTitle||'志愿者申请'}}</text></view></block><block wx:if="{{!loading&&!error}}"><view class="form-container data-v-abb4be80"><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.nameLabel||'姓名'}}</text><input placeholder="{{textConfig.namePlaceholder||'请输入姓名'}}" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" value="{{form.name}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.genderLabel||'性别'}}</text><picker mode="selector" range="{{genders}}" value="{{form.genderIndex}}" data-event-opts="{{[['change',[['onGenderChange',['$event']]]],['input',[['__set_model',['$0','genderIndex','$event',[]],['form']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-abb4be80"><view class="picker data-v-abb4be80">{{''+genders[form.genderIndex]+''}}</view></picker></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.ageLabel||'年龄'}}</text><input type="number" placeholder="{{textConfig.agePlaceholder||'请输入年龄'}}" data-event-opts="{{[['input',[['__set_model',['$0','age','$event',[]],['form']]]]]}}" value="{{form.age}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.phoneLabel||'联系电话'}}</text><input type="number" placeholder="{{textConfig.phonePlaceholder||'请输入联系电话'}}" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['form']]]]]}}" value="{{form.phone}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.emailLabel||'邮箱'}}</text><input placeholder="{{textConfig.emailPlaceholder||'请输入邮箱'}}" data-event-opts="{{[['input',[['__set_model',['$0','email','$event',[]],['form']]]]]}}" value="{{form.email}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.addressLabel||'居住地址'}}</text><input placeholder="{{textConfig.addressPlaceholder||'请输入详细居住地址'}}" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['form']]]]]}}" value="{{form.address}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.skillsLabel||'擅长领域'}}</text><view class="skills-container data-v-abb4be80"><block wx:for="{{$root.l0}}" wx:for-item="skill" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['toggleSkill',['$0'],[[['skills','id',skill.$orig.id,'id']]]]]]]}}" class="{{['skill-item','data-v-abb4be80',(skill.g0)?'active':'']}}" bindtap="__e"><text class="{{['data-v-abb4be80',(skill.g1)?'active':'']}}">{{skill.$orig.name}}</text></view></block></view></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.availableTimeLabel||'可服务时间'}}</text><textarea style="height:120rpx;" placeholder="{{textConfig.availableTimePlaceholder||'请描述您的可服务时间'}}" data-event-opts="{{[['input',[['__set_model',['$0','availableTime','$event',[]],['form']]]]]}}" value="{{form.availableTime}}" bindinput="__e" class="data-v-abb4be80"></textarea></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">{{textConfig.introductionLabel||'个人简介'}}</text><textarea style="height:150rpx;" placeholder="{{textConfig.introductionPlaceholder||'请简要介绍自己'}}" data-event-opts="{{[['input',[['__set_model',['$0','introduction','$event',[]],['form']]]]]}}" value="{{form.introduction}}" bindinput="__e" class="data-v-abb4be80"></textarea></view><button type="primary" data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" bindtap="__e" class="data-v-abb4be80">{{textConfig.submitBtnText||'提交申请'}}</button></view></block></view>