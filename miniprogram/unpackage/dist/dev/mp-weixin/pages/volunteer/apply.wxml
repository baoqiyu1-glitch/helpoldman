<view class="apply-container data-v-abb4be80"><view class="page-header data-v-abb4be80"><text class="title data-v-abb4be80">志愿者申请</text></view><view class="form-container data-v-abb4be80"><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">姓名</text><input placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" value="{{form.name}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">性别</text><picker mode="selector" range="{{genders}}" value="{{form.genderIndex}}" data-event-opts="{{[['change',[['onGenderChange',['$event']]]],['input',[['__set_model',['$0','genderIndex','$event',[]],['form']]]]]}}" bindchange="__e" bindinput="__e" class="data-v-abb4be80"><view class="picker data-v-abb4be80">{{''+genders[form.genderIndex]+''}}</view></picker></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">年龄</text><input type="number" placeholder="请输入年龄" data-event-opts="{{[['input',[['__set_model',['$0','age','$event',[]],['form']]]]]}}" value="{{form.age}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">联系电话</text><input type="number" placeholder="请输入联系电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['form']]]]]}}" value="{{form.phone}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">邮箱</text><input placeholder="请输入邮箱" data-event-opts="{{[['input',[['__set_model',['$0','email','$event',[]],['form']]]]]}}" value="{{form.email}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">居住地址</text><input placeholder="请输入详细居住地址" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['form']]]]]}}" value="{{form.address}}" bindinput="__e" class="data-v-abb4be80"/></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">擅长领域</text><view class="skills-container data-v-abb4be80"><block wx:for="{{$root.l0}}" wx:for-item="skill" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['toggleSkill',['$0'],[[['skills','id',skill.$orig.id,'id']]]]]]]}}" class="skill-item data-v-abb4be80" bindtap="__e"><text class="{{['data-v-abb4be80',(skill.g0)?'active':'']}}">{{skill.$orig.name}}</text></view></block></view></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">可服务时间</text><textarea style="height:120rpx;" placeholder="请描述您的可服务时间" data-event-opts="{{[['input',[['__set_model',['$0','availableTime','$event',[]],['form']]]]]}}" value="{{form.availableTime}}" bindinput="__e" class="data-v-abb4be80"></textarea></view><view class="form-item data-v-abb4be80"><text class="label data-v-abb4be80">个人简介</text><textarea style="height:150rpx;" placeholder="请简要介绍自己" data-event-opts="{{[['input',[['__set_model',['$0','introduction','$event',[]],['form']]]]]}}" value="{{form.introduction}}" bindinput="__e" class="data-v-abb4be80"></textarea></view><button type="primary" data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" bindtap="__e" class="data-v-abb4be80">提交申请</button></view></view>