<view class="container data-v-ab1780d6"><view class="header data-v-ab1780d6"><text class="title data-v-ab1780d6">订单详情</text></view><block wx:if="{{order}}"><view class="order-info data-v-ab1780d6"><view class="info-section data-v-ab1780d6"><text class="section-title data-v-ab1780d6">基本信息</text><view class="info-item data-v-ab1780d6"><text class="label data-v-ab1780d6">订单编号：</text><text class="value data-v-ab1780d6">{{order.id}}</text></view><view class="info-item data-v-ab1780d6"><text class="label data-v-ab1780d6">用户：</text><text class="value data-v-ab1780d6">{{order.userName}}</text></view><view class="info-item data-v-ab1780d6"><text class="label data-v-ab1780d6">下单时间：</text><text class="value data-v-ab1780d6">{{order.time}}</text></view><view class="info-item data-v-ab1780d6"><text class="label data-v-ab1780d6">地址：</text><text class="value data-v-ab1780d6">{{order.address}}</text></view><view class="info-item data-v-ab1780d6"><text class="label data-v-ab1780d6">状态：</text><text class="{{'status-'+order.status}}">{{''+$root.m0+''}}</text></view></view><block wx:if="{{$root.g0}}"><view class="info-section data-v-ab1780d6"><text class="section-title data-v-ab1780d6">商品清单</text><view class="products-list data-v-ab1780d6"><block wx:for="{{order.products}}" wx:for-item="product" wx:for-index="index" wx:key="index"><view class="product-item data-v-ab1780d6"><text class="product-name data-v-ab1780d6">{{product.name}}</text><text class="product-price data-v-ab1780d6">{{"¥"+product.price+" x "+product.quantity}}</text></view></block></view><view class="total data-v-ab1780d6"><text class="total-label data-v-ab1780d6">总计：</text><text class="total-value data-v-ab1780d6">{{"¥"+order.totalPrice}}</text></view></view></block><block wx:if="{{order.description}}"><view class="info-section data-v-ab1780d6"><text class="section-title data-v-ab1780d6">服务内容</text><text class="description data-v-ab1780d6">{{order.description}}</text></view></block><block wx:if="{{order.status==='in_progress'}}"><view class="actions data-v-ab1780d6"><button data-event-opts="{{[['tap',[['completeOrder',['$event']]]]]}}" class="complete-btn data-v-ab1780d6" bindtap="__e">完成订单</button></view></block></view></block><block wx:else><view class="loading data-v-ab1780d6"><text class="data-v-ab1780d6">加载中...</text></view></block></view>