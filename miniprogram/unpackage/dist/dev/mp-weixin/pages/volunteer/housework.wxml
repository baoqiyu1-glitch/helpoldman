<view class="housework-container data-v-dfbad5fa"><block wx:if="{{loading}}"><view class="loading data-v-dfbad5fa">加载中...</view></block><block wx:if="{{error}}"><view class="error data-v-dfbad5fa">{{error}}</view></block><block wx:if="{{!loading&&!error}}"><view class="page-header data-v-dfbad5fa"><text class="title data-v-dfbad5fa">{{textConfig.houseworkTexts&&textConfig.houseworkTexts.pageTitle||'家政服务'}}</text></view></block><block wx:if="{{!loading&&!error}}"><view class="housework-list data-v-dfbad5fa"><block wx:if="{{$root.g0===0}}"><view class="no-tasks data-v-dfbad5fa"><text class="data-v-dfbad5fa">{{textConfig.houseworkTexts&&textConfig.houseworkTexts.noTasks||'暂无家政服务任务'}}</text></view></block><block wx:for="{{$root.l0}}" wx:for-item="task" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['viewTaskDetails',['$0'],[[['houseworkTasks','id',task.$orig.id]]]]]]]}}" class="housework-item data-v-dfbad5fa" bindtap="__e"><view class="task-header data-v-dfbad5fa"><text class="task-title data-v-dfbad5fa">{{task.$orig.taskType}}</text><text class="{{['task-status','data-v-dfbad5fa',(task.$orig.status==='pending')?'pending':'',(task.$orig.status==='accepted')?'accepted':'',(task.$orig.status==='completed')?'completed':'',(task.$orig.status==='rejected')?'rejected':'']}}">{{''+task.m0+''}}</text></view><view class="task-info data-v-dfbad5fa"><text class="user-name data-v-dfbad5fa">{{"用户："+task.$orig.userName}}</text><text class="task-time data-v-dfbad5fa">{{"服务时间："+task.$orig.time}}</text></view><view class="task-address data-v-dfbad5fa"><text class="address-label data-v-dfbad5fa">服务地址：</text><text class="address-detail data-v-dfbad5fa">{{task.$orig.address}}</text></view><view class="task-description data-v-dfbad5fa"><text class="desc-label data-v-dfbad5fa">服务需求：</text><text class="desc-detail data-v-dfbad5fa">{{task.$orig.description}}</text></view><view class="task-estimated data-v-dfbad5fa"><text class="estimated-label data-v-dfbad5fa">预计时长：</text><text class="estimated-detail data-v-dfbad5fa">{{task.$orig.estimatedHours+"小时"}}</text></view><block wx:if="{{task.$orig.status==='pending'}}"><view class="task-actions data-v-dfbad5fa"><button data-event-opts="{{[['tap',[['acceptTask',['$0'],[[['houseworkTasks','id',task.$orig.id]]]]]]]}}" class="accept-btn data-v-dfbad5fa" catchtap="__e">{{''+(textConfig.houseworkTexts&&textConfig.houseworkTexts.acceptBtn||'接单')+''}}</button><button data-event-opts="{{[['tap',[['rejectTask',['$0'],[[['houseworkTasks','id',task.$orig.id]]]]]]]}}" class="reject-btn data-v-dfbad5fa" catchtap="__e">{{''+(textConfig.houseworkTexts&&textConfig.houseworkTexts.rejectBtn||'拒单')+''}}</button></view></block></view></block></view></block></view>